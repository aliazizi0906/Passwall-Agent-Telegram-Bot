#!/bin/sh /etc/rc.common

START=98
STOP=10
USE_PROCD=1

start_service() {
    # Recover any unconfirmed network settings after reboot/service restart.
    # If recovery fails, do not start an Agent that could hide the failure.
    /usr/bin/pw-agent --pw-safe-recover || return 1
    /usr/bin/pw-agent --pw-config-recover || return 1
    procd_open_instance
    procd_set_param command /usr/bin/pw-agent
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/pw-agent/config.json
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "pw-agent"
}
