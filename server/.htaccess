Options -Indexes
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>
<FilesMatch "^(config|config\.example|lib|hardening_v050|platform_v060|setup_core|release_tools|web_auth|fleet_rollout|schema_migrations|bundle_core|v130_command_validation)\.php$|\.sql$|\.lock$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
